:name: mini_autosar two-ECU scenario
:description: SensorEcu (ECU_A) + LightEcu (ECU_B) + rest-bus tester (REST) on one CAN bus (CANHub), UART1 of each machine logged to a file.
# [Educational Implementation] Driven by tools/run_mini_autosar.py which defines these variables before including this file:
#   $elf_a $elf_b $elf_rest        absolute paths of the three ELF images   (use @path syntax, forward slashes)
#   $uart_a $uart_b $uart_rest     UART1 log files (artifacts/mini-autosar/renode/uart_*.log)
#   $profile                       generated fragment: wheel-speed voltage steps + RunFor (see tools/run_mini_autosar.py)
# Real hardware counterpart: three ECUs on a CAN harness; the CANHub plays the role of the bus wires.
# Pattern copied from scripts/multi-node/ramn.resc (CreateCANHub + Connect sysbus.fdcan1).

emulation SetGlobalQuantum "0.0001"
emulation CreateCANHub "canHub"

mach create "ECU_A"
machine LoadPlatformDescription @platforms/boards/ramn.repl
sysbus LoadELF $elf_a
sysbus.usart1 CreateFileBackend $uart_a true
connector Connect sysbus.fdcan1 canHub

mach create "ECU_B"
machine LoadPlatformDescription @platforms/boards/ramn.repl
sysbus LoadELF $elf_b
sysbus.usart1 CreateFileBackend $uart_b true
connector Connect sysbus.fdcan1 canHub

mach create "REST"
machine LoadPlatformDescription @platforms/boards/ramn.repl
sysbus LoadELF $elf_rest
sysbus.usart1 CreateFileBackend $uart_rest true
connector Connect sysbus.fdcan1 canHub

# The profile fragment selects ECU_A (mach set "ECU_A"), then alternates
#   sysbus.adc1 SetVoltage <MICROVOLT> 6  (ADC1 channel 6 = PA1; VERIFIED by agent B: the unit is MICROvolt, not millivolt;
#                                          raw ~ floor(uV*4095/3.3e6), +-1 LSB; see mcal/adc/Adc.c header)
#   emulation RunFor "0.010"
# for the whole scenario length (4 s virtual time).
include $profile
